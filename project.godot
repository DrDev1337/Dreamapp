; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Essens"
config/description="Turbaserat roguelite-RPG för mobil. Samla Essens, riskera allt, gå djupare."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Game="*res://src/autoload/game.gd"
Ads="*res://src/autoload/ads.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

; Webbexport i Godot 4.3 kräver Compatibility-renderaren, och för ett
; UI-baserat 2D-spel är den rätt val även på mobil (lägst overhead).
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Matcha UI:ts bakgrundsfärg så att letterbox-ytor inte blir svarta.
environment/defaults/default_clear_color=Color(0.102, 0.086, 0.129, 1)
; Krävs för webbexport med vram_texture_compression/for_mobile=true –
; utan denna nekar Godot exporten utan felmeddelande.
textures/vram_compression/import_etc2_astc=true
